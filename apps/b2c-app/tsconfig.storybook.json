{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "composite": true,
    "noEmit": false,
    "declaration": true
  },
  "exclude": [
    "components/**/*.spec.ts",
    "components/**/*.test.ts"
  ],
  "include": [
    "components/**/*.stories.ts",
    "components/**/*.stories.js",
    "components/**/*.stories.jsx",
    "components/**/*.stories.tsx",
    "components/**/*.stories.mdx",
    ".storybook/*.js",
    ".storybook/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "../../libs/design-system/src/**/*.ts",
    "../../libs/design-system/src/**/*.tsx"
  ]
}
