                    },
                    {
                      "$ref": "#/components/schemas/AnonymousApiUser"
                    }
                  ],
                  "title": "Response Get Current User Users Me Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
