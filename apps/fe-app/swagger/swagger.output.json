{
  "openapi": "3.0.3",
  "info": {
    "title": "Aress FDP",
    "summary": "API Docs for Aress API",
    "description": "\nAress API helps you get data from Aress Server. 🚀\nThere are several routes:\n\n## Users\nEndpoints for captcha, login, signup, and user data are in this section\n",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "users",
      "description": "Operations with users. In order to **login** for a user, first you must get **captcha** using _/users/login_captcha_ endpoint. Each captcha has a unique identifier and a value, which is _base64_ encoded format of image or audio. Then user must solve captcha value and send it along with his/her credentials to _/users/login_ endpoint. You can use **Authorize** button on top of this page to login for test user."
    }
  ],
  "paths": {
    "/users/login_captcha": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Captcha For Login",
        "description": "Get captcha for a user. Captcha can be an **image** or an **audio**, depending on the **captchaType** param. In case of an image, you can also pass **captchaWidth** and **captchaHeight** for customizing the size of generated image.",
        "operationId": "captcha_for_login_users_login_captcha_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "captchaWidth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 50,
              "default": 280,
              "title": "Captchawidth"
            }
          },
          {
            "name": "captchaHeight",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 50,
              "default": 90,
              "title": "Captchaheight"
            }
          },
          {
            "name": "captchaType",
            "in": "query",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/CaptchaType"
                }
              ],
              "default": "image",
              "title": "Captchatype"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaApiModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Login For Access Token",
        "description": "Get access token using credentials for users. You must provide solved captcha value (_captcha_) and unique identifier of catpcha (_captchaUid_), along with user credentials (_username_ and _password_).**Important note**: _username_ can be either username, email, phone number or national code of user.",
        "operationId": "login_for_access_token_users_login_post",
        "parameters": [
          {
            "name": "captchaUid",
            "in": "query",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Captchauid"
            }
          },
          {
            "name": "captcha",
            "in": "query",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Captcha"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_for_access_token_users_login_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenApiModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/token": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Test User Access Token",
        "description": "Get access token using credentials for test user. This method only works for **test** user. For login flow of real users, you must use **login_captcha** and **login** endpoints.",
        "operationId": "test_user_access_token_users_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_test_user_access_token_users_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenApiModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get Current User",
        "description": "Get data of current logged in user.",
        "operationId": "get_current_user_users_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
