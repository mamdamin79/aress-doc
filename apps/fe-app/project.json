{
  "name": "fe-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fe-app",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project fe-app --web",
  "targets": {
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "configDir": "apps/fe-app/.storybook",
        "port": 6006
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "options": {
        "configDir": "apps/fe-app/.storybook",
        "outputDir": "dist/storybook/fe-app"
      }
    }
  }
}
