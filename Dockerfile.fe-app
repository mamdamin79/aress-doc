FROM node:23.9.0-slim

WORKDIR /app

RUN npm install -g pnpm 
RUN npm add --global nx@19.6.5

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml nx.json tsconfig.base.json /app/
COPY libs/design-system/package.json /app/libs/design-system/
COPY apps/fe-app/package.json /app/apps/fe-app/

RUN pnpm install --frozen-lockfile

# Copy the rest of the application
COPY . /app/

# Build design-system first to ensure CSS is available
# RUN nx run design-system:build-storybook --disable-telemetry

# Build fe-app
ENV NODE_ENV=production
ENV NX_DAEMON=false
RUN nx run fe-app:build --configuration=production --skip-nx-cache --disable-telemetry

EXPOSE 3000:3000

# Change the CMD to serve from the correct Next.js output directory
CMD ["pnpm", "nx", "run", "fe-app:serve", "--port=3000"]
