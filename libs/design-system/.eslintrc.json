{
  "extends": [
    "plugin:@nx/react",
    "../../.eslintrc.json",
    "plugin:storybook/recommended"
  ],
  "ignorePatterns": [
    "!**/*",
    "storybook-static",
    "node_modules",
    "**/vite.config.*.timestamp*",
    "**/vitest.config.*.timestamp*"
  ],
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "allow": [
          "moment",
          "jalali-moment"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    }
  ]
}